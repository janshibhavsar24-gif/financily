{
  "name": "financily-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint ./src ./e2e",
    "lint:fix": "biome lint --write ./src ./e2e",
    "format": "biome format --write ./src ./e2e",
    "check": "biome check ./src ./e2e",
    "check:fix": "biome check --write ./src ./e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5",
    "vite": "^5",
    "tailwindcss": "^3",
    "autoprefixer": "^10",
    "postcss": "^8",
    "@playwright/test": "^1.44",
    "@biomejs/biome": "^1.9.4"
  }
}
